+bool create_tensors_helper::create_flint_tensors(const LLM_TN & tn) {
+    LOADING_PRELUDE
+
+    const int64_t n_ff_exp        = hparams.n_ff_exp;
+    const int64_t n_ff_shexp      = hparams.n_ff_shexp ? hparams.n_ff_shexp : n_ff_exp * hparams.n_expert_shared;
