From 668c78a1dcc3d7e3d7aaae088b41a0e62644e053 Mon Sep 17 00:00:00 2001
From: James Begin <james@example.com>
Date: Tue, 27 Oct 2026 21:41:51 -0400
Subject: [PATCH] fix(server): use safe_json_to_str in res_ok to prevent HTTP
 500 when completion ends on incomplete UTF-8 byte

---
 examples/server/server.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/examples/server/server.cpp b/examples/server/server.cpp
index 1e33a8be..85c1858a 100644
--- a/examples/server/server.cpp
+++ b/examples/server/server.cpp
@@ -427,7 +427,7 @@ auto res_err = [](httplib::Response& res, json error_data) {
 };
 
 auto res_ok = [](httplib::Response& res, const json& data) {
-    res.set_content(data.dump(), "application/json; charset=utf-8");
+    res.set_content(safe_json_to_str(data), "application/json; charset=utf-8");
     res.status = 200;
 };
 
